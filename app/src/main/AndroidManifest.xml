<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wireless-debugging ADB for the settings page's
         phantom-limit lift: pairing/connect ports are found
         over mDNS (AdbMdns), and the pairing code is typed
         into a notification reply (PairingFlow). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reliable mDNS discovery on devices that gate multicast
         reception behind a WifiManager multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Only needed on Android 13+ (runtime permission) for the
         pairing notification; harmless on older versions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground keep-alive for a running supervisor
         session (SupervisorService, 0.9.174). The
         SPECIAL_USE pair is required at targetSdk 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="PaxVM"
        android:theme="@android:style/Theme.Holo">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".StartupDiagnosticsActivity"
            android:exported="false" />
        <activity
            android:name=".SystemLimitActivity"
            android:exported="false" />
        <receiver
            android:name=".PairReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.yongshuai.paxvm.PAIR_CODE" />
            </intent-filter>
        </receiver>
        <service
            android:name=".PairingService"
            android:exported="false" />
        <service
            android:name=".SupervisorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the PaxVM ptrace supervisor process alive while a guest VM session is running" />
        </service>
    </application>

</manifest>
