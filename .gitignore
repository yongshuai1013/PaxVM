*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/app/build
target/
# Native payloads are built by CI and copied into jniLibs; do not commit them.
app/src/main/jniLibs/arm64-v8a/*.so
# The Gingerbread /system subset is built by CI into assets; do not commit it.
app/src/main/assets/gbsystem.zip
# Signing keystores never enter the repo; CI receives the pinned key
# via GitHub secrets (see build.yml), backups live outside the clone.
*.jks
*.keystore
